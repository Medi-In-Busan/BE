# ${DOMAIN}(Android 클라이언트가 호출하는 백엔드 도메인)로 들어오는 요청을
# backend:8080(Spring Boot, 도커 네트워크 내부)으로 리버스 프록시한다.
#
# nginx 공식 이미지는 컨테이너 기동 시 이 파일을 envsubst로 치환해
# /etc/nginx/conf.d/default.conf로 렌더링한다. docker-compose.prod.yml에서
# NGINX_ENVSUBST_FILTER='^DOMAIN$'로 지정해뒀기 때문에 ${DOMAIN}만 실제 값으로
# 바뀌고, $host/$request_uri 같은 nginx 자체 변수는 건드리지 않는다.

server {
    listen 80;
    server_name ${DOMAIN};

    # Let's Encrypt 발급/갱신용 ACME challenge — certbot 컨테이너와 같은
    # webroot 볼륨(certbot-webroot)을 공유해서 응답한다.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # 그 외 모든 HTTP 요청은 HTTPS로 리다이렉트.
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    # 문서 스캔(OCR) 기능이 이미지를 업로드하므로 기본 1m 제한을 넉넉히 올려둔다.
    client_max_body_size 20m;

    location / {
        proxy_pass http://backend:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
